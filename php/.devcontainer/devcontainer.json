{
  "name": "Vault Wallet Management - PHP",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php"
      },
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ]
    }
  }
}
